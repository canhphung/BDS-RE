string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef ID)
set(DIR "${TEST_ROOT}/world-lifecycle-${ID}")
file(MAKE_DIRECTORY "${DIR}")
set(WORLD "${DIR}/test.snapshot")
foreach(TICKS IN ITEMS 2 3)
  execute_process(COMMAND "${SERVER}" --world "${WORLD}" --ticks "${TICKS}" --tick-ms 1
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR TIMEOUT 5)
  if(TICKS EQUAL 2)
    set(EXPECTED_AGE 2)
  else()
    set(EXPECTED_AGE 5)
  endif()
  if(NOT RESULT EQUAL 0 OR NOT OUTPUT MATCHES "saved world age=${EXPECTED_AGE}" OR NOT OUTPUT MATCHES "stopped ticks=${TICKS}")
    message(FATAL_ERROR "Persistence lifecycle failed: ${RESULT} ${OUTPUT} ${ERROR}")
  endif()
endforeach()
file(WRITE "${WORLD}" "corrupt input must survive")
execute_process(COMMAND "${SERVER}" --world "${WORLD}" --ticks 1 --tick-ms 1
  RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR TIMEOUT 5)
file(READ "${WORLD}" PRESERVED)
if(NOT RESULT EQUAL 1 OR NOT PRESERVED STREQUAL "corrupt input must survive")
  message(FATAL_ERROR "Corrupt snapshot was accepted or overwritten: ${RESULT} ${OUTPUT} ${ERROR}")
endif()
file(REMOVE_RECURSE "${DIR}")
